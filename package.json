{
  "name": "repoinsight",
  "private": true,
  "version": "0.1.0",
  "description": "Project 19 prototype - Repository, Issue and Documentation Assistant",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev:api": "npm -w backend run dev",
    "seed": "npm -w backend run seed",
    "test": "npm -w backend test",
    "typecheck": "npm -w backend run typecheck",
    "env:init": "node scripts/gen-env.mjs",
    "infra:up": "docker compose up -d --wait",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs --tail=100",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v",
    "import": "npm -w backend run import --",
    "search:setup": "npm -w backend run search:setup",
    "worker": "npm -w backend run worker",
    "search:rebuild": "npm -w backend run search:rebuild",
    "activity:recompute": "npm -w backend run activity:recompute --",
    "eval": "npm -w backend run eval",
    "bench": "npm -w backend run bench --",
    "dev:web": "npm -w frontend run dev",
    "build:web": "npm -w frontend run build",
    "seed:scale": "npm -w backend run seed:scale --",
    "bench:drain": "npm -w backend run bench:drain"
  }
}
