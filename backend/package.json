{
  "name": "@repoinsight/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "tsx src/seed/cli.ts",
    "test": "vitest run",
    "import": "tsx src/ingest/cli.ts",
    "search:setup": "tsx src/search/setup.ts",
    "worker": "tsx src/stream/worker.ts",
    "search:rebuild": "tsx src/search/rebuild-cli.ts",
    "activity:recompute": "tsx src/stream/recompute-cli.ts",
    "eval": "tsx src/eval/run.ts",
    "bench": "tsx src/eval/bench.ts",
    "seed:scale": "tsx src/seed/scale.ts",
    "bench:drain": "tsx src/eval/drain.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@opensearch-project/opensearch": "^3.10.0",
    "fastify": "^5.2.1",
    "kafkajs": "^2.2.4",
    "mongodb": "^6.13.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.1.0"
  }
}
