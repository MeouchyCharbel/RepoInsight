# Copy to .env with `npm run env:init` (generates random secrets) - never commit .env.
# All services bind to 127.0.0.1 only.

# --- MongoDB (authoritative store; single-node replica set rs0) ---
MONGO_ROOT_USER=ri_root
MONGO_ROOT_PASSWORD=change-me
MONGO_APP_USER=ri_app
MONGO_APP_PASSWORD=change-me
MONGO_DB=repoinsight
# Internal replica-set key (base64, 32+ chars)
MONGO_REPLICA_KEY=change-me
MONGO_URL=mongodb://ri_app:change-me@127.0.0.1:27017/repoinsight?authSource=repoinsight&directConnection=true

# --- OpenSearch (derived search projection; security plugin enabled) ---
# Must be strong: upper, lower, digit, special, 8+ chars
OPENSEARCH_ADMIN_PASSWORD=change-me
OPENSEARCH_URL=https://127.0.0.1:9200

# --- Kafka (KRaft, SASL/PLAIN on the client listener) ---
KAFKA_APP_USER=ri_app
KAFKA_APP_PASSWORD=change-me
KAFKA_BROKERS=127.0.0.1:9092

# --- Backend ---
API_PORT=4000
# Set to true only when served over HTTPS (adds the Secure flag to the session cookie)
COOKIE_SECURE=false

# --- Demo users (synthetic data only; shared by alice, bob, carol, ops) ---
DEMO_USER_PASSWORD=change-me

# --- GitHub (optional; read-only fine-grained token, public repos only) ---
GITHUB_TOKEN=
